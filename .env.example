# Odoo backend origin. Required locally and in Vercel Preview/Production environments.
# The app calls {VITE_API_URL}/bt_hrms_mobile_access/api/v1/...
VITE_API_URL=

# Local Vite dev/preview server settings. These are not required on Vercel.
FRONTEND_PORT=5173

# Optional extra hostnames allowed to reach the dev/preview server (e.g. a tunnel or LAN name).
ALLOWED_HOST_TEST=
ALLOWED_HOST_SERVER=
